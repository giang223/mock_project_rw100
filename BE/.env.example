# Local MySQL settings. Change the username/password to match the selected MySQL instance.
DB_URL=jdbc:mysql://localhost:3306/minisocial_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Replace before deploying. The dev profile has its own local fallback.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_REFRESH_COOKIE_NAME=MINISOCIAL_REFRESH
AUTH_REFRESH_COOKIE_PATH=/api/auth
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=Lax

# Optional Google/Facebook OAuth. Enable with SPRING_PROFILES_ACTIVE=dev,oauth.
# Register {OAUTH_REDIRECT_BASE_URL}/login/oauth2/code/google and /facebook at the providers.
# In prod, both public provider redirect and FE callback URLs must use HTTPS.
# Facebook email is verified by this app before first session; it never auto-links an existing account.
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
OAUTH_CALLBACK_URL=http://localhost:5173/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0

# Mailpit local SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@minisocial.local

# Optional for local boot; required for image upload operations.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
